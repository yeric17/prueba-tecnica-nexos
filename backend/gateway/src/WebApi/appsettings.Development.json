{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 120
  },
  "ReverseProxy": {
    "Routes": {
      "route-users-me": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "users-service/users/me"
        },
        "Transforms": [
          { "PathRemovePrefix": "/users-service" },
          { "RequestHeadersCopy": "true" }
        ],
        "AuthorizationPolicy": "OrdersPaymentsPolicy"
      },
      "route1": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "users-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/users-service" },
          { "RequestHeadersCopy": "true" }
        ]
      },
      "route2": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "orders-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orders-service" }
        ],
        "AuthorizationPolicy": "OrdersPaymentsPolicy"
      },
      "route3": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "payments-service/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/payments-service" }
        ],
        "AuthorizationPolicy": "OrdersPaymentsPolicy"
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://users-webapi:8080/api"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orders-webapi:8080/api"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payments-webapi:8080/api"
          }
        }
      }
    }  
  }
}
