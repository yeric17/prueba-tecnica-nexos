{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 120
  },
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "users-cluster",
        "Match": {
